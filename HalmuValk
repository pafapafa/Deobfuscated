local function refreshNotifications()
    local tweenService = game:GetService('TweenService')

    for i, record in ipairs(notifications)do
        if record.bar and record.bar.Parent then
            local notificationY = notificationTopOffset + (i - 1) * (notificationHeight + notificationSpacing)

            tweenService:Create(record.bar, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0, notificationY),
            }):Play()
        end
    end
end

function nexlib:Notification(title, desc, duration)
    duration = duration or defaultNotificationDuration

    local notificationText = tostring(title or '')

    if desc and desc ~= '' then
        notificationText = notificationText .. '  \u{b7}  ' .. tostring(desc)
    end

    local tweenService = game:GetService('TweenService')

    while#notifications >= maxNotifications do
        local oldNotification = table.remove(notifications)

        if oldNotification and oldNotification.bar and oldNotification.bar.Parent then
            local labelFadeOut = tweenService:Create(oldNotification.label, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1})
            local collapseTween = tweenService:Create(oldNotification.bar, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, notificationHeight),
                BackgroundTransparency = 1,
            })
            local strokeFadeTween = tweenService:Create(oldNotification.stroke, TweenInfo.new(0.2), {Transparency = 1})

            labelFadeOut:Play()
            collapseTween:Play()
            strokeFadeTween:Play()
            collapseTween.Completed:Connect(function()
                pcall(function()
                    if oldNotification.bar then
                        oldNotification.bar:Destroy()
                    end
                end)
                refreshNotifications()
            end)
        end
    end

    local notificationBar = Instance.new('Frame')

    notificationBar.Name = 'Notification'
    notificationBar.Parent = notificationContainer
    notificationBar.AnchorPoint = Vector2.new(0.5, 0)
    notificationBar.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    notificationBar.BorderSizePixel = 0
    notificationBar.Position = UDim2.new(0.5, 0, 0, notificationTopOffset)
    notificationBar.Size = UDim2.new(0, 0, 0, notificationHeight)
    notificationBar.ClipsDescendants = true
    notificationBar.BackgroundTransparency = 0.05
    notificationBar.ZIndex = 100

    local notificationStroke = Instance.new('UIStroke')

    notificationStroke.Parent = notificationBar
    notificationStroke.Color = nexlib.accentclr
    notificationStroke.Thickness = 1.5
    notificationStroke.Transparency = 0.25

    local notificationAccent = Instance.new('Frame')

    notificationAccent.Name = 'AccentLine'
    notificationAccent.Parent = notificationBar
    notificationAccent.BackgroundColor3 = nexlib.accentclr
    notificationAccent.BorderSizePixel = 0
    notificationAccent.Size = UDim2.new(0, 3, 1, 0)
    notificationAccent.Position = UDim2.new(0, 0, 0, 0)

    local label = Instance.new('TextLabel')

    label.Parent = notificationBar
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Size = UDim2.new(1, -28, 1, 0)
    label.Font = Enum.Font.Code
    label.Text = notificationText
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextTransparency = 1
    label.TextTruncate = Enum.TextTruncate.None

    local textService = game:GetService('TextService')
    local textBounds = textService:GetTextSize(notificationText, 13, Enum.Font.Code, Vector2.new(2000, notificationHeight))
    local notificationWidth = math.clamp(textBounds.X + 48, 200, 480)

    table.insert(notifications, 1, {
        bar = notificationBar,
        label = label,
        stroke = notificationStroke,
    })
    refreshNotifications()

    local expandTween = tweenService:Create(notificationBar, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, notificationWidth, 0, notificationHeight),
    })
    local labelFadeIn = tweenService:Create(label, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0})

    expandTween:Play()
    task.delay(0.08, function()
        labelFadeIn:Play()
    end)
    task.delay(duration, function()
        for i, record in ipairs(notifications)do
            if record.bar == notificationBar then
                table.remove(notifications, i)

                break
            end
        end

        if not notificationBar or not notificationBar.Parent then
            refreshNotifications()

            return
        end

        local labelFadeOut = tweenService:Create(label, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1})
        local collapseTween = tweenService:Create(notificationBar, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, notificationHeight),
            BackgroundTransparency = 1,
        })
        local strokeFadeTween = tweenService:Create(notificationStroke, TweenInfo.new(0.22), {Transparency = 1})

        labelFadeOut:Play()
        collapseTween:Play()
        strokeFadeTween:Play()
        collapseTween.Completed:Connect(function()
            pcall(function()
                notificationBar:Destroy()
            end)
            refreshNotifications()
        end)
    end)
end
