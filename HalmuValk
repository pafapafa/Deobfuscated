    for player, drawings in pairs(espDrawings)do
        local boxFrame, name, healthBg, healthBar = drawings.Box, drawings.Name, drawings.HealthBg, drawings.HealthBar
        local boxStroke = drawings.BoxStroke
        local char = player.Character
        local rootPart = char and char:FindFirstChild('HumanoidRootPart')
        local humanoid = char and char:FindFirstChildOfClass('Humanoid')
        local headOrHitbox = char and (char:FindFirstChild('Head') or char:FindFirstChild('HitboxHead') or rootPart)
        local weaponName = drawings.Weapon

        local function hideEspDrawing()
            boxFrame.Visible = false
            name.Visible = false
            healthBg.Visible = false
            healthBar.Visible = false

            if weaponName then
                weaponName.Visible = false
            end
        end

        if espEnabled and rootPart and humanoid and headOrHitbox and humanoid.Health > 0 then
            local topPos = headOrHitbox.Position + Vector3.new(0, 0.6, 0)
            local bottomPos = rootPart.Position - Vector3.new(0, 3, 0)
            local topScreen, topOnScreen = Camera:WorldToViewportPoint(topPos)
            local bottomScreen, bottomOnScreen = Camera:WorldToViewportPoint(bottomPos)
            local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if (rootOnScreen or topOnScreen or bottomOnScreen) and rootScreen.Z > 0 then
                local boxHeight = math.abs(topScreen.Y - bottomScreen.Y)

                if boxHeight < 8 then
                    boxHeight = 40
                end

                local boxWidth = boxHeight * 0.55
                local boxX = rootScreen.X - boxWidth / 2
                local boxY = topScreen.Y

                if espBoxEnabled then
                    boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                    boxFrame.Position = UDim2.fromOffset(boxX, boxY)

                    local teamColor = isTeammate(player) and Color3.fromRGB(80, 160, 255) or Color3.fromRGB(255, 70, 70)

                    if boxStroke then
                        boxStroke.Color = teamColor
                    end

                    boxFrame.Visible = true
                else
                    boxFrame.Visible = false
                end
                if espNameEnabled then
                    local distText = ''

                    if localRoot then
                        distText = ' [' .. math.floor((rootPart.Position - localRoot.Position).Magnitude) .. 'm]'
                    end

                    name.Text = (player.DisplayName or player.Name) .. distText
                    name.Position = UDim2.fromOffset(rootScreen.X - 80, boxY - 16)
                    name.TextColor3 = isTeammate(player) and Color3.fromRGB(120, 180, 255) or Color3.fromRGB(255, 255, 255)
                    name.Visible = true
                else
                    name.Visible = false
                end
                if espHealthEnabled then
                    local healthPct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)

                    healthBg.Size = UDim2.fromOffset(3, boxHeight)
                    healthBg.Position = UDim2.fromOffset(boxX - 6, boxY)
                    healthBg.Visible = true

                    local barHeight = math.max(boxHeight * healthPct, 1)

                    healthBar.Size = UDim2.fromOffset(3, barHeight)
                    healthBar.Position = UDim2.fromOffset(boxX - 6, boxY + (boxHeight - barHeight))
                    healthBar.BackgroundColor3 = Color3.fromHSV(healthPct * 0.33, 1, 1)
                    healthBar.Visible = true
                else
                    healthBg.Visible = false
                    healthBar.Visible = false
                end
                if espWeaponEnabled and weaponName then
                    local weaponDisplay = getWeaponInfo(player)

                    if weaponDisplay and weaponDisplay ~= '' then
                        weaponName.Text = weaponDisplay
                        weaponName.Position = UDim2.fromOffset(rootScreen.X - 90, boxY + boxHeight + 2)
                        weaponName.TextColor3 = isTeammate(player) and Color3.fromRGB(140, 190, 255) or Color3.fromRGB(220, 220, 220)
                        weaponName.Visible = true
                    else
                        weaponName.Visible = false
                    end
                elseif weaponName then
                    weaponName.Visible = false
                end
            else
                hideEspDrawing()
            end
        else
            hideEspDrawing()
        end
    end
end)

local mouseHeld = false
local nextClickTime = 0
local rayParams = RaycastParams.new()

rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isCrosshairEnemy()
    local char = LocalPlayer.Character

    if not char then
        return false
    end

    rayParams.FilterDescendantsInstances = {char, Camera}

    local rayResult = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 400, rayParams)

    if rayResult and rayResult.Instance then
        local hitModel = rayResult.Instance:FindFirstAncestorOfClass('Model')

        if hitModel and hitModel ~= char then
            local humanoid = hitModel:FindFirstChildOfClass('Humanoid')

            if humanoid and humanoid.Health > 0 then
                local hitPlayer = Players:GetPlayerFromCharacter(hitModel)

                if hitPlayer and isTeammate(hitPlayer) then
                    return false
                end

                return true
            end
        end
    end

    return false
end

RunService.RenderStepped:Connect(function()
    if not triggerbotEnabled then
        if mouseHeld then
            pcall(mouse1release)

            mouseHeld = false
        end

        return
    end
    if mouse1click and (isrbxactive or iswindowactive) and (isrbxactive() or iswindowactive()) then
        if isCrosshairEnemy() then
            if nextClickTime < tick() then
                if mouseHeld then
                    pcall(mouse1release)

                    nextClickTime = tick() + 0.07
                else
                    pcall(mouse1press)
                end

                mouseHeld = not mouseHeld
            end
        else
            if mouseHeld then
                pcall(mouse1release)

                mouseHeld = false
            end
        end
    end
end)

local lighting = game:GetService('Lighting')
local savedLighting = {}
local shaderBlur = Instance.new('BlurEffect')

shaderBlur.Name = 'ShaderBlur'
shaderBlur.Size = 6

local shaderColorCorrection = Instance.new('ColorCorrectionEffect')

shaderColorCorrection.Name = 'ShaderColor'
shaderColorCorrection.Saturation = -0.35

local function enableShader()
    savedLighting = {
        Ambient = lighting.Ambient,
        Brightness = lighting.Brightness,
        OutdoorAmbient = lighting.OutdoorAmbient,
        ShadowSoftness = lighting.ShadowSoftness,
        TimeOfDay = lighting.TimeOfDay,
        ColorShift_Top = lighting.ColorShift_Top,
        ColorShift_Bottom = lighting.ColorShift_Bottom,
    }
    lighting.Ambient = Color3.fromRGB(94, 99, 188)
    lighting.Brightness = 3.5
    lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    lighting.ShadowSoftness = 2.5
    lighting.TimeOfDay = '00:30:00'
    lighting.ColorShift_Top = Color3.fromRGB(0, 0, 0)
    lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
    shaderBlur.Parent = lighting
    shaderColorCorrection.Parent = lighting
end
local function disableShader()
    if next(savedLighting) then
        lighting.Ambient = savedLighting.Ambient
        lighting.Brightness = savedLighting.Brightness
        lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
        lighting.ShadowSoftness = savedLighting.ShadowSoftness
        lighting.TimeOfDay = savedLighting.TimeOfDay
        lighting.ColorShift_Top = savedLighting.ColorShift_Top
        lighting.ColorShift_Bottom = savedLighting.ColorShift_Bottom
    end

    shaderBlur.Parent = nil
    shaderColorCorrection.Parent = nil
end

local lastShaderState = false

RunService.Heartbeat:Connect(function()
    if shaderEnabled ~= lastShaderState then
        lastShaderState = shaderEnabled

        if shaderEnabled then
            enableShader()
        else
            disableShader()
        end
    end
end)
