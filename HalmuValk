local function getWeaponInfo(player)
    local weaponName, ammoDisplay = nil, nil

    pcall(function()
        local fighterController = FighterController

        if not fighterController then
            local success, loadedFighterController = pcall(require, LocalPlayer.PlayerScripts.Controllers.FighterController)

            if success then
                fighterController = loadedFighterController
                FighterController = loadedFighterController
            end
        end
        if not fighterController then
            return
        end

        local fighter = nil

        if type(fighterController.GetFighter) == 'function' then
            fighter = fighterController:GetFighter(player)
        end
        if not fighter and player == LocalPlayer then
            fighter = fighterController.LocalFighter
        end
        if not fighter then
            return
        end

        local equippedItem = fighter.EquippedItem

        if not equippedItem then
            local char = player.Character
            local equippedTool = char and char:FindFirstChildOfClass('Tool')

            if equippedTool then
                weaponName = equippedTool.Name
            end

            return
        end

        local function getItemProperty(key)
            local readSucceeded, value = pcall(function()
                if equippedItem.Get then
                    return equippedItem:Get(key)
                end

                return equippedItem[key] or (equippedItem.Data and equippedItem.Data[key]) or (equippedItem.Info and equippedItem.Info[key])
            end)

            if readSucceeded then
                return value
            end

            return nil
        end

        local currentAmmo = getItemProperty('CurrentAmmo') or getItemProperty('Ammo') or getItemProperty('Bullets') or getItemProperty('MagazineAmmo')
        local reserveAmmo = getItemProperty('ReserveAmmo') or getItemProperty('StoredAmmo') or getItemProperty('Reserve') or getItemProperty('TotalAmmo')
        local isReloading = getItemProperty('Reloading') or getItemProperty('IsReloading')

        if equippedItem.Info and type(equippedItem.Info) == 'table' then
            if currentAmmo == nil then
                currentAmmo = equippedItem.Info.CurrentAmmo or equippedItem.Info.Ammo
            end
            if reserveAmmo == nil then
                reserveAmmo = equippedItem.Info.ReserveAmmo or equippedItem.Info.StoredAmmo
            end
            if equippedItem.Info.Reloading == true or equippedItem.Info.IsReloading == true then
                isReloading = true
            end
        end

        local reloadCooldown = rawget(equippedItem, '_reload_cooldown')

        if type(reloadCooldown) == 'number' and reloadCooldown > tick() then
            isReloading = true
        end

        local name = equippedItem.Name or getItemProperty('Name') or 'weapon'

        weaponName = (isReloading == true) and '*Reloading*' or tostring(name)

        if typeof(currentAmmo) == 'number' and typeof(reserveAmmo) == 'number' then
            ammoDisplay = string.format('%d/%d', math.floor(currentAmmo + 0.5), math.floor(reserveAmmo + 0.5))
        elseif typeof(currentAmmo) == 'number' then
            ammoDisplay = tostring(math.floor(currentAmmo + 0.5))
        end
    end)

    if not weaponName then
        pcall(function()
            local char = player.Character
            local equippedTool = char and char:FindFirstChildOfClass('Tool')

            if equippedTool then
                weaponName = equippedTool.Name
            end
        end)
    end
    if not weaponName then
        return nil
    end
    if ammoDisplay and ammoDisplay ~= '' then
        return weaponName .. ' | ' .. ammoDisplay
    end

    return weaponName
