local function isTeammate(player)
    if not teamCheckEnabled then
        return false
    end

    local localTeamId = LocalPlayer:GetAttribute('TeamID')
    local targetTeamId = player:GetAttribute('TeamID')

    if localTeamId == nil or targetTeamId == nil then
        return false
    end

    return targetTeamId == localTeamId
end
local function isInvulnerable(playerOrChar)
    local char = playerOrChar

    if typeof(playerOrChar) == 'Instance' and playerOrChar:IsA('Player') then
        char = playerOrChar.Character
    end
    if not char then
        return true
    end
    if char:FindFirstChildOfClass('ForceField') then
        return true
    end

    local rootPart = char:FindFirstChild('HumanoidRootPart')

    if rootPart and rootPart:FindFirstChild('Attachment') then
        return true
    end

    local immuneAttribute = char:GetAttribute('Immune') or char:GetAttribute('Invincible') or char:GetAttribute('IsImmune')

    if immuneAttribute == true then
        return true
    end

    local humanoid = char:FindFirstChildOfClass('Humanoid')

    if humanoid then
        local humanoidImmune = humanoid:GetAttribute('Immune') or humanoid:GetAttribute('Invincible')

        if humanoidImmune == true then
            return true
        end
    end

    return false
end
local function isReflectingOrParrying(player)
    local char = player and player.Character

    if not char then
        return false
    end

    local defenseAttributeNames = {
        'Reflecting',
        'IsReflecting',
        'BulletReflect',
        'Reflect',
        'Deflecting',
        'Parrying',
    }

    for _, a in ipairs(defenseAttributeNames)do
        local value = char:GetAttribute(a)

        if value == true or value == 1 or value == 'true' then
            return true
        end

        local humanoid = char:FindFirstChildOfClass('Humanoid')

        if humanoid then
            local humanoidDefenseAttribute = humanoid:GetAttribute(a)

            if humanoidDefenseAttribute == true or humanoidDefenseAttribute == 1 then
                return true
            end
        end
    end

    local hasKatana = false
    local equippedTool = char:FindFirstChildOfClass('Tool')

    if equippedTool and string.find(string.lower(equippedTool.Name), 'katana', 1, true) then
        hasKatana = true
    end

    for _, ch in ipairs(char:GetChildren())do
        local childNameLower = string.lower(ch.Name)

        if string.find(childNameLower, 'katana', 1, true) then
            hasKatana = true
        end
        if string.find(childNameLower, 'reflect', 1, true) or string.find(childNameLower, 'deflect', 1, true) then
            return true
        end
    end

    local humanoid = char:FindFirstChildOfClass('Humanoid')

    if humanoid then
        local success, animationTracks = pcall(function()
            return humanoid:GetPlayingAnimationTracks()
        end)

        if success and animationTracks then
            for _, track in ipairs(animationTracks)do
                local trackName = string.lower(tostring(track.Name or ''))
                local animationId = ''

                pcall(function()
                    if track.Animation then
                        animationId = tostring(track.Animation.AnimationId or '')
                    end
                end)

                local animationInfo = trackName .. ' ' .. string.lower(animationId)

                if string.find(animationInfo, 'reflect', 1, true) or string.find(animationInfo, 'deflect', 1, true) or string.find(animationInfo, 'parry', 1, true) or string.find(animationInfo, 'block', 1, true) then
                    if hasKatana or string.find(animationInfo, 'katana', 1, true) then
                        return true
                    end
                    if string.find(animationInfo, 'reflect', 1, true) or string.find(animationInfo, 'deflect', 1, true) then
                        return true
                    end
                end
            end
        end
    end

    return false
end

