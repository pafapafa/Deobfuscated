local function makeDraggable(clickObject, dragObject)
    pcall(function()
        local isDragging = false
        local dragInput, dragStartPosition, dragStartGuiPosition

        clickObject.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                dragStartPosition = input.Position
                dragStartGuiPosition = dragObject.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        isDragging = false
                    end
                end)
            end
        end)
        clickObject.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        game:GetService('UserInputService').InputChanged:Connect(function(input)
            if input == dragInput and isDragging then
                local dragDelta = input.Position - dragStartPosition

                dragObject.Position = UDim2.new(dragStartGuiPosition.X.Scale, dragStartGuiPosition.X.Offset + dragDelta.X, dragStartGuiPosition.Y.Scale, dragStartGuiPosition.Y.Offset + dragDelta.Y)
            end
        end)
    end)
end

