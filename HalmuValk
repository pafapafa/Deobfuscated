local originalItemAttributes = {
    ShootCooldown = setmetatable({}, {
        __mode = 'k',
    }),
    ShootRecoil = setmetatable({}, {
        __mode = 'k',
    }),
}

local function overrideItemAttribute(attribute, value)
    local attributeBackup = originalItemAttributes[attribute]

    if not attributeBackup then
        return
    end

    for _, gcVal in pairs(getgc(true))do
        if type(gcVal) == 'table' then
            local originalAttributeValue = rawget(gcVal, attribute)

            if originalAttributeValue ~= nil then
                if attributeBackup[gcVal] == nil then
                    attributeBackup[gcVal] = originalAttributeValue
                end

                gcVal[attribute] = value
            end
        end
    end
end
local function restoreItemAttribute(attribute)
    local attributeBackup = originalItemAttributes[attribute]

    if not attributeBackup then
        return
    end

    for gcVal, original in pairs(attributeBackup)do
        if type(gcVal) == 'table' then
            pcall(function()
                gcVal[attribute] = original
            end)
        end

        attributeBackup[gcVal] = nil
    end
end

local originalReloadLengths = {}
local projectileReloadOverridden = false

local function enableInstantProjectileReload()
    local ItemLibrary = require(game:GetService('ReplicatedStorage').Modules.ItemLibrary)
    local Items = rawget(ItemLibrary, 'Items')

    if not Items then
        return
    end

    local projectileWeapons = {
        'Bow',
        'Daggers',
        'Slingshot',
    }

    for _, Item in pairs(Items)do
        local Name = Item.Name

        if table.find(projectileWeapons, Name) and Item.ReloadLength ~= nil then
            if originalReloadLengths[Name] == nil then
                originalReloadLengths[Name] = Item.ReloadLength
            end

            rawset(Item, 'ReloadLength', (Name == 'Daggers' and 0.09 or 0))
        end
    end

    projectileReloadOverridden = true
end
